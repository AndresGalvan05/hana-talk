# Copy this to infra/.env (gitignored) and point it at your own LLM keys
# file, kept outside the repo so no tooling ever reads its contents through
# a repo-relative path.
LLM_KEYS_ENV_PATH=/home/YOU/.config/dev-projects/llm-keys.env

# Optional: point core-api's OTLP export at your real Grafana Cloud stack
# for local verification, instead of the default local Jaeger. Same
# outside-the-repo pattern as the LLM keys file above. Leave unset to keep
# using local Jaeger. Expected contents of the file at this path:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp/v1/traces
#   GRAFANA_CLOUD_OTLP_METRICS_URL=https://otlp-gateway-<region>.grafana.net/otlp/v1/metrics
#   GRAFANA_CLOUD_METRICS_ENABLED=true
#   OTEL_EXPORTER_OTLP_AUTH=Basic <base64 of instanceId:apiToken>
GRAFANA_CLOUD_ENV_PATH=/home/YOU/.config/dev-projects/grafana-cloud.env
