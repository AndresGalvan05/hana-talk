{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select your Grafana Cloud Prometheus/Mimir datasource on import.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "HanaTalk ai-exercise-svc overview",
  "uid": "hanatalk-ai-exercise-svc-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["hanatalk", "ai-exercise-svc"],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Note",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Metric names and labels verified live against Grafana Cloud on 2026-08-06 (service-metrics-export). `FastAPIInstrumentor`'s HTTP metrics use the older OTel HTTP semantic conventions -- `http_server_duration_milliseconds_{bucket,count,sum}` (millisecond-suffixed, not `_seconds`), labeled `http_target`/`http_method`/`http_status_code`. This is a different label set from `event-worker`'s dashboard, which uses the newer stable semconv (`http_route`/`http_request_method`/`http_response_status_code`) -- both confirmed real, not assumed identical."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"ai-exercise-svc\"}[5m])) by (http_target, http_method)",
          "legendFormat": "{{http_method}} {{http_target}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP error rate (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"ai-exercise-svc\", http_status_code=~\"5..\"}[5m])) by (http_target)",
          "legendFormat": "{{http_target}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM call rate by provider and outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(llm_call_total{service_name=\"ai-exercise-svc\"}[5m])) by (provider, success)",
          "legendFormat": "{{provider}} ({{success}})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM call duration (p95) by provider",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_call_duration_seconds_bucket{service_name=\"ai-exercise-svc\"}[5m])) by (le, provider))",
          "legendFormat": "{{provider}}"
        }
      ]
    }
  ]
}
