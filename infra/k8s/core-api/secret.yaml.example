# TEMPLATE ONLY (.example is skipped by `kubectl apply -f <dir>`) — never
# commit real values. Create the secret manually on the cluster:
#
#   kubectl create secret generic core-api-secret -n hanatalk \
#     --from-literal=DB_USERNAME=hanatalk \
#     --from-literal=DB_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=JWT_SECRET="$(openssl rand -base64 48)" \
#     --from-literal=OTEL_EXPORTER_OTLP_AUTH="Basic <base64 of instanceId:apiToken>"
#
# OTEL_EXPORTER_OTLP_AUTH (M5): Grafana Cloud's Basic-auth header value for
# the OTLP endpoint, from Connections -> OTLP in the Grafana Cloud UI.
# Applies to both traces and metrics export — one shared header, matching
# application.yml's management.otlp.tracing/metrics.export.headers.
# Access policy must include both metrics:write and traces:write scopes.
#
# Postgres reads DB_USERNAME/DB_PASSWORD from the same secret, so the DB and
# the API can never disagree. See infra/k8s/README.md for the full bring-up.
apiVersion: v1
kind: Secret
metadata:
  name: core-api-secret
  namespace: hanatalk
type: Opaque
stringData:
  DB_USERNAME: <value>
  DB_PASSWORD: <value>
  JWT_SECRET: <value>
  OTEL_EXPORTER_OTLP_AUTH: <value>
