# TEMPLATE ONLY (.example is skipped by `kubectl apply -f <dir>`) — never
# commit real values. Create the secret manually, from your laptop (the
# LLM keys file never needs to touch the VM -- kubectl reads it locally
# and sends it over the existing SSH tunnel):
#
#   kubectl create secret generic ai-exercise-svc-secret -n hanatalk \
#     --from-env-file=~/.config/dev-projects/llm-keys.env \
#     --from-literal=OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<base64>"
#
# OTEL_EXPORTER_OTLP_HEADERS: the standard OTel SDK env var (comma-separated
# key=value, URL-encoded) -- read natively by the Python OTel SDK, unlike
# core-api's Spring-specific OTEL_EXPORTER_OTLP_AUTH. Same underlying
# Grafana Cloud Basic-auth value as core-api's, just reformatted:
# "Authorization=Basic%20<same base64 as core-api-secret's
# OTEL_EXPORTER_OTLP_AUTH value, with the space after "Basic" as %20>".
#
# GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY: read directly by
# each provider's SDK from the environment (see ai-exercise-svc/app/
# providers.py) -- no application config references these keys by name
# beyond that.
apiVersion: v1
kind: Secret
metadata:
  name: ai-exercise-svc-secret
  namespace: hanatalk
type: Opaque
stringData:
  GEMINI_API_KEY: <value>
  GROQ_API_KEY: <value>
  OPENROUTER_API_KEY: <value>
  OTEL_EXPORTER_OTLP_HEADERS: <value>
