# TEMPLATE ONLY (.example is skipped by `kubectl apply -f <dir>`) — never
# commit real values. Create manually:
#
#   kubectl create secret generic event-worker-secret -n hanatalk \
#     --from-literal=OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<base64>"
#
# Same underlying Grafana Cloud Basic-auth value as core-api-secret's
# OTEL_EXPORTER_OTLP_AUTH and ai-exercise-svc-secret's
# OTEL_EXPORTER_OTLP_HEADERS -- just reformatted per this SDK's convention
# (standard OTel env var, URL-encoded).
#
# Note: event-worker's DB credentials are NOT duplicated here -- they're
# reused directly from core-api-secret via Kubernetes' $(VAR) env
# expansion in deployment.yaml, so this secret only ever needs the one key.
apiVersion: v1
kind: Secret
metadata:
  name: event-worker-secret
  namespace: hanatalk
type: Opaque
stringData:
  OTEL_EXPORTER_OTLP_HEADERS: <value>
